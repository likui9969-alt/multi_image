# 应用配置
APP_NAME=AI Style Studio
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./style_transfer.db

# JWT 配置（生产环境必须修改）
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 文件上传配置
UPLOAD_DIR=./uploads
RESULT_DIR=./results
MAX_UPLOAD_SIZE_MB=10

# CORS 配置（逗号分隔；生产环境请改为实际域名；"*" 仅开发用）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# 文件清理（TTL，单位：小时；0 表示不清理）
FILE_TTL_HOURS=72

# 图片处理
MAX_IMAGE_DIMENSION=2048
JPEG_QUALITY=85

# Stability AI 配置（获取地址：https://platform.stability.ai/account/keys）
STABILITY_API_KEY=your-stability-api-key-here
AI_TIMEOUT_SECONDS=60

# 模式配置
# true: 使用模拟模式（无需 API key，免费但无真实转换效果）
# false: 使用 Stability AI 真实 API（需要 API key）
USE_MOCK_AI=true

# 风格转换强度（仅真实 API 模式，0=保留原图，1=完全新图）
STYLE_STRENGTH=0.7
